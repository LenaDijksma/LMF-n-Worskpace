import { Button, TextEdit, LineEdit, ScrollView, ListView, Palette } from "std-widgets.slint";

// Colours and scale come from Rust (src/theme.rs, src/settings.rs).
export global Theme {
    in property <color> window-bg: #f5f5f5;
    in property <color> sidebar-bg: #f4f4f6;
    in property <color> sidebar-text: #1f1f1f;
    in property <color> sidebar-muted: #595959;
    in property <color> hover: #e3e6f6;
    in property <color> panel-bg: #ffffff;
    in property <color> text: #1f1f1f;
    in property <color> link: #1565c0;
    in property <color> diag-bg: #fafafa;
    in property <color> border: #8a8a96;
    in property <float> scale: 1.0;
}

export struct TableCell {
    rich: styled-text,
    // 0 = left, 1 = center, 2 = right
    align: int,
}

export struct TableRow {
    cells: [TableCell],
    header: bool,
}

export struct PreviewItem {
    title: string,
    body: string,
    indent: length,
    fill: color,
    accent: color,
    font-size: length,
    mono: bool,
    // Rich (formatted) text; when false, `body` is shown as plain text.
    is-rich: bool,
    rich: styled-text,
    rule: bool,
    rows: [TableRow],
}

export struct DiagItem {
    text: string,
    tint: color,
}

export struct NavItem {
    label: string,
    detail: string,
    path: string,
}

export struct LinkItem {
    text: string,
    path: string,
    tint: color,
    header: bool,
}

export component MainWindow inherits Window {
    title: root.window-title;
    background: Theme.window-bg;
    preferred-width: 1480px;
    preferred-height: 820px;
    min-width: 900px;
    min-height: 480px;

    in property <string> window-title: "Lovely Workspace";
    in property <string> status: "";
    in property <string> save-status: "";
    in property <string> folder-label: "No folder open";
    in property <string> theme-name: "Light";
    in property <bool> dark-scheme: false;
    in property <length> editor-font-size: 14px;
    in-out property <string> editor-text: "";
    in-out property <bool> diag-open: true;
    in property <[PreviewItem]> preview-items: [];
    in property <[DiagItem]> diagnostics: [];
    in property <[NavItem]> nav-items: [];
    in property <[LinkItem]> link-items: [];

    callback open-clicked();
    callback save-clicked();
    callback text-edited(string);
    callback open-folder-clicked();
    callback search-edited(string);
    callback nav-clicked(string);
    callback link-clicked(string);
    callback rich-link-clicked(string);
    callback theme-clicked();
    callback font-smaller();
    callback font-larger();

    init => {
        Palette.color-scheme = root.dark-scheme ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-scheme => {
        Palette.color-scheme = root.dark-scheme ? ColorScheme.dark : ColorScheme.light;
    }

    // Keyboard shortcuts (Ctrl, or Cmd on macOS):
    //   S save · O open file · Shift+O open folder · F search
    //   + / - font size · Shift+T cycle theme · J show/hide problems
    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == "s") { root.save-clicked(); return accept; }
                if (event.text == "o") { root.open-clicked(); return accept; }
                if (event.text == "O") { root.open-folder-clicked(); return accept; }
                if (event.text == "f") { search-input.focus(); return accept; }
                if (event.text == "=" || event.text == "+") { root.font-larger(); return accept; }
                if (event.text == "-") { root.font-smaller(); return accept; }
                if (event.text == "T") { root.theme-clicked(); return accept; }
                if (event.text == "j") { root.diag-open = !root.diag-open; return accept; }
            }
            return reject;
        }

        HorizontalLayout {
            // ---------------- Sidebar: files, search, links ----------------
            Rectangle {
                width: 300px * Theme.scale;
                background: Theme.sidebar-bg;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    Button {
                        text: "Open folder…";
                        clicked => { root.open-folder-clicked(); }
                    }
                    Text {
                        text: root.folder-label;
                        color: Theme.sidebar-muted;
                        font-size: 11px * Theme.scale;
                        wrap: word-wrap;
                    }
                    search-input := LineEdit {
                        placeholder-text: "Search notes…";
                        edited(t) => { root.search-edited(t); }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        ListView {
                            for n in root.nav-items: Rectangle {
                                height: 46px * Theme.scale;
                                background: nav-touch.has-hover ? Theme.hover : transparent;
                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    Text {
                                        text: n.label;
                                        color: Theme.sidebar-text;
                                        font-size: 14px * Theme.scale;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: n.detail;
                                        color: Theme.sidebar-muted;
                                        font-size: 11px * Theme.scale;
                                        overflow: elide;
                                    }
                                }
                                nav-touch := TouchArea {
                                    clicked => { root.nav-clicked(n.path); }
                                    accessible-role: button;
                                    accessible-label: n.label + ", " + n.detail;
                                    accessible-action-default => { root.nav-clicked(n.path); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: min(root.link-items.length * 26px * Theme.scale, 210px * Theme.scale);
                        background: Theme.panel-bg;
                        ListView {
                            for l in root.link-items: Rectangle {
                                height: 26px * Theme.scale;
                                background: link-touch.has-hover && l.path != "" ? Theme.hover : transparent;
                                Text {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    text: l.text;
                                    color: l.tint;
                                    font-size: 12px * Theme.scale;
                                    font-weight: l.header ? 700 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                link-touch := TouchArea {
                                    enabled: l.path != "";
                                    clicked => { root.link-clicked(l.path); }
                                    accessible-role: button;
                                    accessible-label: l.text;
                                    accessible-action-default => { root.link-clicked(l.path); }
                                }
                            }
                        }
                    }
                }
            }

            // ---------------- Main area ----------------
            VerticalLayout {
                // Toolbar
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Button {
                        text: "Open file…";
                        clicked => { root.open-clicked(); }
                    }
                    Button {
                        text: "Save";
                        clicked => { root.save-clicked(); }
                    }
                    Text {
                        text: root.save-status;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "A−";
                        clicked => { root.font-smaller(); }
                    }
                    Button {
                        text: "A+";
                        clicked => { root.font-larger(); }
                    }
                    Button {
                        text: "Theme: " + root.theme-name;
                        clicked => { root.theme-clicked(); }
                    }
                }

                // Editor | Preview
                HorizontalLayout {
                    spacing: 1px;

                    TextEdit {
                        font-size: root.editor-font-size;
                        text <=> root.editor-text;
                        edited(t) => { root.text-edited(t); }
                    }

                    Rectangle {
                        background: Theme.panel-bg;
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                spacing: 8px;
                                padding: 14px;

                                for item in root.preview-items: HorizontalLayout {
                                    Rectangle { width: item.indent; }
                                    Rectangle {
                                        background: item.fill;
                                        border-radius: 6px;
                                        HorizontalLayout {
                                            if !item.rule: Rectangle {
                                                width: 4px;
                                                background: item.accent;
                                            }
                                            VerticalLayout {
                                                padding: 10px;
                                                spacing: 4px;
                                                if item.title != "": Text {
                                                    text: item.title;
                                                    font-weight: 700;
                                                    color: item.accent;
                                                    font-size: 15px * Theme.scale;
                                                    wrap: word-wrap;
                                                }
                                                if item.rule: Rectangle {
                                                    height: 2px;
                                                    background: item.accent;
                                                }
                                                if item.body != "" && !item.is-rich: Text {
                                                    text: item.body;
                                                    color: Theme.text;
                                                    wrap: word-wrap;
                                                    font-size: item.font-size;
                                                    font-family: item.mono ? "monospace" : "";
                                                }
                                                if item.is-rich: StyledText {
                                                    text: item.rich;
                                                    default-color: Theme.text;
                                                    link-color: Theme.link;
                                                    default-font-size: item.font-size;
                                                    link-clicked(url) => { root.rich-link-clicked(url); }
                                                }
                                                if item.rows.length > 0: VerticalLayout {
                                                    for row in item.rows: HorizontalLayout {
                                                        for cell in row.cells: Rectangle {
                                                            horizontal-stretch: 1;
                                                            border-width: 1px;
                                                            border-color: Theme.border;
                                                            background: row.header ? Theme.hover : transparent;
                                                            VerticalLayout {
                                                                padding: 6px;
                                                                StyledText {
                                                                    text: cell.rich;
                                                                    default-color: Theme.text;
                                                                    link-color: Theme.link;
                                                                    default-font-size: item.font-size;
                                                                    horizontal-alignment: cell.align == 1 ? TextHorizontalAlignment.center : (cell.align == 2 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left);
                                                                    link-clicked(url) => { root.rich-link-clicked(url); }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Room to scroll the last card fully into view (the scroll area can under-measure wrapped text).
                                Rectangle { height: max(80px, root.height * 0.3); }
                            }
                        }
                    }
                }

                // Problems: a slim bar that can be collapsed; the list only takes the space it needs.
                VerticalLayout {
                    Rectangle {
                        height: 26px * Theme.scale;
                        background: Theme.diag-bg;
                        Text {
                            x: 12px;
                            text: (root.diag-open ? "▾ " : "▸ ") + "Problems  ·  " + root.status;
                            color: Theme.text;
                            font-size: 12px * Theme.scale;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.diag-open = !root.diag-open; }
                            accessible-role: button;
                            accessible-label: "Show or hide problems";
                            accessible-action-default => { root.diag-open = !root.diag-open; }
                        }
                    }
                    Rectangle {
                        height: root.diag-open ? min(root.diagnostics.length * 22px * Theme.scale, 140px * Theme.scale) : 0px;
                        clip: true;
                        background: Theme.diag-bg;
                        ListView {
                            for d in root.diagnostics: Rectangle {
                                height: 22px * Theme.scale;
                                Text {
                                    x: 12px;
                                    text: d.text;
                                    color: d.tint;
                                    font-size: 12px * Theme.scale;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
